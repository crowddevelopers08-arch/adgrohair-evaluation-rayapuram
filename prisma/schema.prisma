generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Submission {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  source        String
  name          String
  phone         String
  email         String?
  age           String?
  gender        String?
  concern       String
  answers       Json?
  medicalDetail String?
  score         Int?
  band          String?
  pageUrl       String?
  telecrmStatus String?

  @@index([createdAt])
  @@index([phone])
}
